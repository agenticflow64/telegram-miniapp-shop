# Telegram-бот: токен из @BotFather
TELEGRAM_BOT_TOKEN=

# Публичный HTTPS-адрес Mini App (кнопка "Запустить приложение" в боте)
WEBAPP_URL=https://your-domain.example

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=goods_db

# Elasticsearch
ELASTIC_PASSWORD=elastic

# S3-хранилище фотографий товаров (любое S3-совместимое)
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT=
S3_REGION=ru-1
S3_BUCKET=goods-bucket

# JWT: секрет приложения (сгенерируйте, например: openssl rand -hex 32)
JWT_SECRET_KEY=

# Учётка администратора (создаётся при первом запуске)
APP_ADMIN_LOGIN=admin
APP_ADMIN_PASSWORD=admin

# Необязательно: локальный каталог с изображениями для сидирования демо-товаров
SEED_IMAGES_DIR=
